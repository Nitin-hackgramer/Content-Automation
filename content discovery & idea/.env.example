# Copy to .env and fill in. Keep .env private; never commit it.
# This project reads ONLY its own .env. It needs its own bot, its own Supabase project, its own keys.

# Telegram bot for this project (create a NEW bot with @BotFather; do not reuse another app's token)
TELEGRAM_BOT=
# Your chat id with that bot. Message the bot once, then run:  .venv\Scripts\python -m agent.telegram_discovery --chat-id
# Only this chat can drive the bot (/discover /trending /ideas /brief and the approval buttons); every other chat is ignored.
TELEGRAM_CHAT_ID=

# Shared secret for POST /news and webhook auth. Generate a new random value for this project.
TRIGGER_SECRET=

# Groq (LLM)
GROQ_API_KEY=
# Optional model overrides
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_DEEP_MODEL=openai/gpt-oss-120b

# Supabase (memory store). Use this project's own project, and its secret/service_role key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Set on a public deployment only, to the public base URL (enables the Telegram webhook)
# RENDER_EXTERNAL_URL=
